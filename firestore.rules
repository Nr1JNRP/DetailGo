rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shops — leitura pública para o mapa, escrita apenas pelo dono
    match /shops/{shopId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null;

      // Subcoleções do shop
      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Usuários — só o próprio usuário acessa
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /appointments/{appointmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Notificações do cliente (escritas pela Cloud Function, lidas pelo dono)
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Pagamentos — apenas backend (Cloud Functions)
    match /payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
